# Reglas para un hosting Apache/LiteSpeed, como Hostinger.
#
# En Vercel esto lo hacian vercel.json (cabeceras de cache) y .vercelignore
# (que impedia publicar el material fuente). Un hosting comun no lee ninguno
# de los dos, asi que lo que valia alla hay que decirlo otra vez aca.

# --- Lo que no se publica --------------------------------------------------
# uploads/ es material fuente del cliente: originales, PDFs internos y videos.
# Si la carpeta llego al servidor por FTP, esto la cierra igual. Lo mismo para
# los archivos fuente del editor y los de configuracion del repositorio.
RedirectMatch 404 ^/uploads(/|$)
RedirectMatch 404 ^/web(/|$)
RedirectMatch 404 ^/docs(/|$)
RedirectMatch 404 \.dc\.html$
RedirectMatch 404 ^/(vercel\.json|package(-lock)?\.json|README\.md)$
RedirectMatch 404 /\.(git|claude|env)

# --- Un solo dominio ------------------------------------------------------
# www y sin www devolvian los dos la misma pagina con codigo 200. Para un
# buscador eso son dos sitios con el mismo contenido, y reparte entre los dos
# lo que deberia ir a uno. Se queda el que uso el cliente: sin www.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://xn--doacompra-m6a.com/$1 [L,R=301]
</IfModule>

# --- Cache ----------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Las imagenes y los videos llevan el nombre fijo, asi que un cache largo
  # obliga a renombrar el archivo cuando cambia. Es a proposito: es lo que
  # evita que alguien vea una foto vieja durante un ano.
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType video/mp4                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  # La pagina no: es un solo archivo que cambia en cada despliegue, y si se
  # cachea, un cambio tarda dias en verse.
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|mp4|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# --- Compresion -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Codificacion ---------------------------------------------------------
AddDefaultCharset UTF-8

# --- Errores --------------------------------------------------------------
# El sitio es una sola pagina con ruteo por hash: cualquier direccion que no
# sea un archivo la atiende index.html.
ErrorDocument 404 /index.html
